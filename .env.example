# NexaFlow environment configuration.
#
# Copy to .env and fill in values appropriate to your environment. Never commit
# secrets. All values are read server-side only.

# PostgreSQL connection URL. Required at application boot.
DATABASE_URL=

# Email infrastructure (used by invitation/verification flows). Optional in
# development: flows degrade to the manual-link fallback when unset.
RESEND_API_KEY=
EMAIL_FROM=

# Canonical public application URL used to build links inside emails
# (https:// in production; http://localhost:3000 is accepted in development).
APP_URL=

# Dedicated test database for the automated security test suite. Must be
# separate from DATABASE_URL. Required by `npm run test:run`.
TEST_DATABASE_URL=
